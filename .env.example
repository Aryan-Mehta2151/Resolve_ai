# Local development values only. Never use these credentials outside a local machine.
POSTGRES_USER=resolveai
POSTGRES_PASSWORD=local-development-only-change-me
POSTGRES_DB=resolveai
POSTGRES_PORT=5432

REDIS_PASSWORD=local-development-only-change-me
REDIS_PORT=6379

MINIO_ROOT_USER=resolveai
MINIO_ROOT_PASSWORD=local-development-only-change-me
MINIO_LICENSE_FILE=./docker/minio.license
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# Use aws_s3 with an empty endpoint and AWS credential-chain credentials when hosted.
KNOWLEDGE_STORAGE_BACKEND=minio
S3_ACCESS_KEY_ID=resolveai
S3_SECRET_ACCESS_KEY=local-development-only-change-me
S3_REGION_NAME=us-east-1
KNOWLEDGE_BUCKET=resolveai-knowledge
KNOWLEDGE_MAX_FILE_BYTES=10485760
KNOWLEDGE_INGESTION_TIMEOUT_SECONDS=120

DATABASE_URL=postgresql+asyncpg://resolveai:local-development-only-change-me@postgres:5432/resolveai
REDIS_URL=redis://:local-development-only-change-me@redis:6379/0
CELERY_RESULT_BACKEND=redis://:local-development-only-change-me@redis:6379/1
S3_ENDPOINT_URL=http://minio:9000
API_PORT=8000
WEB_PORT=3000

# Generate a private 32+ character value and set it in .env before using auth.
JWT_SECRET_KEY=
ALLOW_SELF_REGISTRATION=false
CUSTOMER_EMAIL_SMTP_HOST=mailpit
CUSTOMER_EMAIL_SMTP_PORT=1025
CUSTOMER_EMAIL_SMTP_STARTTLS=false
CUSTOMER_EMAIL_FROM_ADDRESS=no-reply@localhost
CUSTOMER_EMAIL_VERIFICATION_URL=http://localhost:3000/customer
CUSTOMER_EMAIL_VERIFICATION_MINUTES=30
CUSTOMER_EMAIL_RESEND_COOLDOWN_SECONDS=60
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
# Local mock actions only; disable when connecting real commerce providers.
DEMO_BUSINESS_WORKFLOWS_ENABLED=true
AGENT_INTENT_PROVIDER=deterministic
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AGENT_MODEL_TIMEOUT_SECONDS=8
# Browser voice demo: configure a saved Vapi assistant and an HTTPS API tunnel.
# Store the matching webhook token as a Vapi Custom Credential, never in the browser.
VAPI_ENABLED=false
VAPI_PUBLIC_KEY=
VAPI_ASSISTANT_ID=
VAPI_WEBHOOK_SECRET=
VAPI_PUBLIC_API_URL=
VAPI_RESULT_WAIT_SECONDS=8
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
